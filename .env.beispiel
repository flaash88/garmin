# Takt — Umgebungsvariablen
# Kopieren nach .env und ausfüllen. .env gehört nicht ins Repo.
# Die Liste wächst mit den Phasen; hier steht, was bis Phase 1 gebraucht wird.

# --- Datenbank ---------------------------------------------------------------
# PostgreSQL. Im Verbund aus docker-compose.yml ist der Wirt 'datenbank'.
TAKT_DATENBANK_URL=postgres://takt:GEHEIM@localhost:5432/takt

# --- Anmeldung (Phase 2) -----------------------------------------------------
# argon2id-Hash des einen Passworts. Erzeugen mit: pnpm hash
TAKT_PASSWORT_HASH=
# Geheimnis für das signierte Sitzungscookie. Lang und zufällig, z. B.
#   openssl rand -base64 48
TAKT_SITZUNG_SECRET=

# Kopf, aus dem die Herkunft für den Zähler je IP gelesen wird. Nur ein Kopf,
# den der eigene Verbund setzt — vor cloudflared ist das CF-Connecting-IP.
# X-Forwarded-For wird bewusst nicht genommen: den setzt der Aufrufer selbst.
# Leer lassen, wenn kein solcher Kopf ankommt; dann greift der Zähler über
# alles, der ohnehin immer greift.
TAKT_IP_KOPF=cf-connecting-ip

# --- intervals.icu (Phase 3) -------------------------------------------------
# HTTP Basic: Benutzername ist wörtlich API_KEY, Passwort ist dieser Schlüssel.
ICU_API_KEY=
ICU_ATHLET_ID=
# Gemeinsames Geheimnis für /api/icu/webhook. Der Endpunkt liegt ausserhalb
# der Anmeldung — intervals.icu hat kein Sitzungscookie — und weist ohne
# gesetztes Geheimnis jede Anfrage ab.
#   openssl rand -base64 32
TAKT_WEBHOOK_SECRET=

# --- Coach (Phase 5) ---------------------------------------------------------
# Bleibt auf dem Server. Wird nie an den Browser gegeben.
ANTHROPIC_API_KEY=
# Eigene Postgres-Rolle, ausschliesslich SELECT auf das Auswertungsschema.
# Getrennt von TAKT_DATENBANK_URL, damit sql_abfrage nicht schreiben kann.
# Anlegen mit:
#   TAKT_COACH_PASSWORT=… bash datenbank/einrichten.sh
TAKT_SQL_ROLLE_URL=postgres://takt_coach:GEHEIM@localhost:5432/takt

# Passwort fuer die Coach-Rolle. Nur beim Einrichten noetig, nicht im Betrieb.
TAKT_COACH_PASSWORT=

# --- Betrieb (Phase 6) -------------------------------------------------------
CLOUDFLARED_TOKEN=
