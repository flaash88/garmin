# Takt — Umgebungsvariablen
# Kopieren nach .env und ausfüllen. .env gehört nicht ins Repo.
# Die Liste wächst mit den Phasen; hier steht, was bis Phase 1 gebraucht wird.

# --- Datenbank ---------------------------------------------------------------
# PostgreSQL. Im Verbund aus docker-compose.yml ist der Wirt 'datenbank'.
TAKT_DATENBANK_URL=postgres://takt:GEHEIM@localhost:5432/takt

# --- Anmeldung (Phase 2) -----------------------------------------------------
# argon2id-Hash des einen Passworts. Erzeugen mit: pnpm hash
TAKT_PASSWORT_HASH=
# Geheimnis für das signierte Sitzungscookie. Lang und zufällig, z. B.
#   openssl rand -base64 48
TAKT_SITZUNG_SECRET=

# --- intervals.icu (Phase 3) -------------------------------------------------
# HTTP Basic: Benutzername ist wörtlich API_KEY, Passwort ist dieser Schlüssel.
ICU_API_KEY=
ICU_ATHLET_ID=

# --- Coach (Phase 5) ---------------------------------------------------------
# Bleibt auf dem Server. Wird nie an den Browser gegeben.
ANTHROPIC_API_KEY=
# Eigene Postgres-Rolle, ausschließlich SELECT auf die Analyse-Views.
# Getrennt von TAKT_DATENBANK_URL, damit sql_abfrage nicht schreiben kann.
TAKT_SQL_ROLLE_URL=

# --- Betrieb (Phase 6) -------------------------------------------------------
CLOUDFLARED_TOKEN=
