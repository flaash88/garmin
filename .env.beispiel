# =============================================================================
# Takt — Umgebungsvariablen
#
# Kopieren nach .env und ausfüllen:   cp .env.beispiel .env
# .env gehört nicht ins Repo und steht in .gitignore.
#
# Die mit (nötig) markierten Werte müssen gesetzt sein, sonst startet der
# Verbund nicht. Die übrigen schalten Teile ab, wenn sie leer bleiben.
# =============================================================================

# --- Datenbank ---------------------------------------------------------------
# (nötig) Passwort des Datenbankbenutzers. Erzeugen mit:
#   openssl rand -hex 32
#
# Bewusst hex, nicht base64: dieses Passwort wird in eine
# Verbindungszeichenkette postgres://benutzer:passwort@… eingesetzt, und
# base64 liefert in rund drei von vier Fällen ein «/» oder «+». Ein «/»
# macht die Zeichenkette unbrauchbar — die Datenbank startet trotzdem
# gesund, und erst die Anwendung scheitert.
POSTGRES_PASSWORD=
POSTGRES_USER=takt
POSTGRES_DB=takt

# Wird aus den drei Werten oben zusammengesetzt. Nur ausserhalb des Verbunds
# von Hand setzen, etwa beim Entwickeln gegen eine örtliche Datenbank.
# TAKT_DATENBANK_URL=postgres://takt:GEHEIM@localhost:5432/takt

# --- Anmeldung ---------------------------------------------------------------
# (nötig) argon2id-Hash des einen Passworts. Erzeugen mit:
#   pnpm hash
# Die Eingabe wird verdeckt abgefragt und landet in keiner Verlaufsdatei.
TAKT_PASSWORT_HASH=

# (nötig) Geheimnis für das signierte Sitzungscookie. Mindestens 32 Zeichen:
#   openssl rand -base64 48
# Ein Wechsel meldet alle Sitzungen ab.
TAKT_SITZUNG_SECRET=

# Kopf, aus dem die Herkunft für den Zähler je IP gelesen wird. Nur ein Kopf,
# den der eigene Vorbau setzt — hinter cloudflared ist das CF-Connecting-IP.
# Steht etwas anderes davor, den Kopf eintragen, den es setzt.
# X-Forwarded-For wird bewusst nicht genommen: den setzt der Aufrufer selbst.
# Fällt nichts ab, greift der Zähler über alles, der ohnehin immer greift.
TAKT_IP_KOPF=cf-connecting-ip

# --- intervals.icu -----------------------------------------------------------
# HTTP Basic: der Benutzername ist wörtlich API_KEY, das Passwort dieser
# Schlüssel. Zu finden unter Einstellungen → Developer.
# Bleibt er leer, startet Takt, holt aber nichts.
ICU_API_KEY=
ICU_ATHLET_ID=

# Gemeinsames Geheimnis für /api/icu/webhook. Der Endpunkt liegt ausserhalb
# der Anmeldung — intervals.icu hat kein Sitzungscookie — und weist ohne
# gesetztes Geheimnis jede Anfrage ab.
#   openssl rand -base64 32
TAKT_WEBHOOK_SECRET=

# --- Coach -------------------------------------------------------------------
# Der Coach läuft über das Claude-Code-Abo, nicht über einen API-Schlüssel.
#
# Token interaktiv erzeugen — der Befehl öffnet den Browser zur Anmeldung:
#   claude setup-token
#
# Der ausgegebene Wert beginnt mit sk-ant-oat01-. Hier eintragen. Er bleibt
# auf dem Server und wird nie an den Browser gegeben.
#
# ANTHROPIC_API_KEY wird bewusst NICHT gesetzt — auch nicht zusätzlich. Das
# SDK führt beide Variablen in derselben Gruppe; sind beide gesetzt, hängt an
# der Reihenfolge, welches Konto die Nutzung trägt.
#
# Ohne Token läuft Takt vollständig, nur der Coach antwortet mit 503.
CLAUDE_CODE_OAUTH_TOKEN=

# (nötig, sobald der Coach genutzt wird) Passwort der Rolle takt_coach.
# Ebenfalls hex — es geht in dieselbe Art Verbindungszeichenkette:
#   openssl rand -hex 32
# Diese Rolle hat ausschliesslich SELECT auf das Auswertungsschema und kommt
# an keine Tabelle mit Zugangsdaten heran. Anlegen mit:
#   TAKT_COACH_PASSWORT=… bash datenbank/einrichten.sh
TAKT_COACH_PASSWORT=

# Pfad zur nativen Binärdatei des Agent SDK. Normalerweise leer lassen —
# Takt findet sie selbst. Nur nötig, wenn die Suche einmal danebengreift; die
# Startprüfung sagt dann, was sie gesucht hat.
TAKT_CLAUDE_BINAERDATEI=

# --- Betrieb -----------------------------------------------------------------
# Der Verbund bringt keinen Tunnel mit. Der Webdienst hört auf
# 127.0.0.1:3000, nur auf dem Wirt; was davor HTTPS liefert — cloudflared,
# ein Reverse Proxy —, läuft dort und gehört nicht in diese Datei.
#
# Zahl der vorgehaltenen Sicherungsstände.
SICHERUNG_STAENDE=7

# Zeitzone für Protokolle und Zeitpläne.
TZ=Europe/Vienna
