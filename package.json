{
  "name": "takt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "hash": "node --experimental-strip-types scripts/hash.ts",
    "erstbefuellung": "node --experimental-strip-types --env-file-if-exists=.env scripts/erstbefuellung.ts",
    "abgleich": "node --experimental-strip-types --env-file-if-exists=.env scripts/abgleich.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
